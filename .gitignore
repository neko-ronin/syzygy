node_modules/
dist/
.DS_Store
*.log

# Reference video: ~670MB of binary quality-bar material, never source. Untracked
# AND purged from history (see docs/DECISIONS.md D22), so the repo is ~1MB
# instead of ~930MB. The files themselves live on disk and are not recoverable
# from a fresh clone -- copy them from a working checkout before comparing against
# them, or `tools/compare.mjs --ref` will not find its source.
#
# The pattern is a bare `*.mov`, NOT `inspirations/**/*.mov`. The latter looks
# equivalent and does nothing: verified on git 2.54 (Apple Git-157), it matches
# nothing and `git add -A` stages all nine videos. Tested in a scratch repo.
# A bare glob is also why this line needs no edit when the directory is renamed.
*.mov

# Iteration output. Screenshots are evidence, not source. Every run churns these,
# and a 10-pose sequence is ~25MB, so history grew ~210MB of PNGs before this was
# purged. Purged from history too, baseline included -- if the curated set is ever
# wanted again it is one capture run away, and storing renders in git was never
# worth the clone cost.
#
# Consequence: shots/baseline/ is no longer a committed baseline. compare.mjs
# falls back to CURRENT-only columns when it is absent, which is a weaker
# comparison, not a broken one. See docs/DECISIONS.md D22.
shots/

# Claude Code: launch.json is shared config; worktrees and local settings are per machine.
.claude/worktrees/
.claude/settings.local.json

# Wrangler scratch state.
.wrangler/

# Runtime logs (tools/publish.mjs): local diagnostics, may hold local paths.
logs/
